<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Shelf — four games</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#14101F">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --void:#14101f;
  --void-2:#1d1730;
  --edge:rgba(246,242,255,.10);
  --mist:#a79dbe;
  --bright:#f6f2ff;
  --a1:#4fa8ff;
  --a2:#ffe93d;
  --display:'Syne','Arial Black','Haettenschweiler',system-ui,sans-serif;
  --ui:ui-sans-serif,system-ui,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--void);
  color:var(--bright);
  font-family:var(--ui);
  -webkit-font-smoothing:antialiased;
  overflow:hidden;
}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:2px solid var(--a2);outline-offset:3px}

/* ---------------- home ---------------- */
#home{
  position:fixed;inset:0;
  display:grid;
  grid-template-rows:auto 1fr auto;
  padding:clamp(18px,3.4vh,34px) clamp(18px,3.6vw,52px);
  gap:clamp(14px,2.4vh,26px);
  overflow:auto;
}
#home[hidden]{display:none}

.top{display:flex;align-items:baseline;justify-content:space-between;gap:16px}
.mark{font-family:var(--display);font-weight:800;font-size:clamp(19px,2vw,25px);letter-spacing:-.02em}
.mark span{color:var(--a1);transition:color .45s ease}
.count{color:var(--mist);font-size:13.5px}

.body{
  display:grid;
  grid-template-columns:minmax(280px,.86fr) 1.14fr;
  gap:clamp(18px,2.6vw,44px);
  align-items:stretch;
  min-height:0;
}

/* list */
.shelf{display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0}
.row{
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:12px;
  width:100%;
  text-align:left;
  padding:clamp(11px,1.7vh,19px) 4px;
  border-top:1px solid var(--edge);
  transition:padding-left .25s ease;
}
.shelf .row:last-child{border-bottom:1px solid var(--edge)}
.row h2{
  font-family:var(--display);font-weight:700;
  font-size:clamp(24px,3.1vw,42px);
  line-height:1.02;letter-spacing:-.025em;
  margin:0;color:var(--mist);
  transition:color .25s ease;
  overflow-wrap:break-word;
  position:relative;
}
.row .kind{color:var(--mist);font-size:12.5px;opacity:.65;white-space:nowrap}
.row.on{padding-left:16px}
.row.on h2{color:var(--bright)}
.row.on .kind{color:var(--a2);opacity:1}
.shelf{position:relative}
.row{position:relative}
.row.on{border-left:0}
.row.on h2::before{
  content:"";
  position:absolute;left:-11px;top:50%;
  width:7px;height:7px;margin-top:-3.5px;
  background:var(--a2);border-radius:50%;
}
@media (hover:hover){.row:hover h2{color:var(--bright)}}

/* art panel */
.panel{
  position:relative;
  border:1px solid var(--edge);
  border-radius:3px;
  background:linear-gradient(163deg, var(--void-2) 0%, #100d1a 100%);
  background:
    radial-gradient(120% 100% at 78% 6%, color-mix(in srgb, var(--a1) 26%, transparent) 0%, transparent 62%),
    linear-gradient(163deg, var(--void-2) 0%, #100d1a 100%);
  overflow:hidden;
  display:flex;flex-direction:column;
  min-height:0;
  transition:background .5s ease;
}
.art{flex:1;position:relative;min-height:150px}
.art svg{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .38s ease}
.art svg.on{opacity:1}
.blurb{
  padding:clamp(16px,2.3vw,28px);
  border-top:1px solid var(--edge);
  background:rgba(8,6,14,.45);
  display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;
}
.blurb p{margin:0;max-width:46ch;color:var(--mist);font-size:clamp(13.5px,1.06vw,15.5px);line-height:1.6}
.blurb b{display:block;color:var(--bright);font-weight:600;margin-bottom:4px}
.play{
  font-family:var(--display);font-weight:800;
  font-size:clamp(15px,1.35vw,19px);letter-spacing:.01em;
  padding:13px 30px;border-radius:2px;
  background:var(--a2);color:#141019;
  white-space:nowrap;
  transition:background .45s ease,transform .12s ease;
}
.play:active{transform:translateY(1px)}

.foot{color:var(--mist);font-size:12.5px;opacity:.7}
.foot kbd{
  font:inherit;border:1px solid var(--edge);border-radius:3px;
  padding:1px 6px;margin:0 1px;color:var(--bright);
}

/* ---------------- stage ---------------- */
#stage{position:fixed;inset:0;background:#000;z-index:100}
#stage[hidden]{display:none}
#frame{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
#exit{
  position:fixed;top:12px;left:12px;z-index:101;
  display:flex;align-items:center;gap:8px;
  padding:8px 15px 8px 12px;border-radius:999px;
  background:rgba(10,8,16,.62);border:1px solid rgba(246,242,255,.22);
  color:#f6f2ff;font-size:13.5px;
  backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);
  opacity:.32;transition:opacity .2s ease;
}
#exit:hover,#exit:focus-visible{opacity:1}
#hint{
  position:fixed;top:56px;left:12px;z-index:101;
  max-width:270px;padding:9px 13px;border-radius:4px;
  background:rgba(10,8,16,.72);border:1px solid var(--edge);
  color:var(--mist);font-size:12.5px;line-height:1.5;
  transition:opacity .6s ease;
}
#hint.gone{opacity:0;pointer-events:none}

@media (max-width:860px){
  body{overflow:auto}
  #home{position:static;min-height:100%;grid-template-rows:auto auto auto}
  .body{grid-template-columns:1fr;gap:20px}
  .panel{order:-1}
  .art{min-height:34vh}
  .blurb{flex-direction:column;align-items:stretch}
  .play{width:100%;text-align:center}
  .row h2{font-size:29px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition-duration:.01ms!important}
}
.spin{transform-origin:center;animation:spin 34s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.drift{animation:drift 6s ease-in-out infinite}
@keyframes drift{50%{transform:translateY(-7px)}}
</style>
</head>
