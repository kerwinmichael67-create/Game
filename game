.btn-x { background: #2f6fd8; } .btn-y { background: #e8b400; }
.play-btn { margin-top: 8px; background: linear-gradient(180deg, #f4f8ff, #d7e6ff); color: #1b2a5a; font-size: 44px; text-align: center; padding: 8px 0; letter-spacing: 2px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; box-shadow: 0 6px 0 #1e2f6e, 0 0 20px rgba(120,180,255,0.5); transform: skew(-6deg); }
.play-btn:hover { filter: brightness(1.05); transform: skew(-6deg) translateY(-2px); }
.lb-bottom { position: absolute; left: 0; right: 0; bottom: 0; height: 46px; background: rgba(10,20,50,0.75); display: flex; align-items: center; padding: 0 60px; gap: 24px; font-size: 19px; }
.lb-bottom .glob { font-size: 21px; }
.lb-bottom .rt { margin-left: auto; }
.lb-bottom .rt + .rt { margin-left: 0; }
.lbk { display: inline-flex; min-width: 22px; height: 22px; padding: 0 5px; border: 2px solid rgba(255,255,255,0.8); border-radius: 50%; align-items: center; justify-content: center; font-family: Arial, sans-serif; font-weight: bold; font-size: 12px; margin-right: 6px; }

#lb-locker { position: absolute; left: 50%; top: 110px; transform: translateX(-50%); width: 760px; background: rgba(14,24,56,0.92); padding: 16px; border-top: 3px solid #4a6ad8; }
.locker-t { font-size: 24px; letter-spacing: 1px; margin-bottom: 10px; }
.skins { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.skin-card { background: rgba(255,255,255,0.08); border: 2px solid rgba(255,255,255,0.2); padding: 8px; cursor: pointer; text-align: center; }
.skin-card.sel { border-color: #ffe93d; background: rgba(255,233,61,0.15); }
.skin-sw { height: 90px; border-radius: 4px; margin-bottom: 6px; }
.skin-n { font-size: 18px; }
.locker-hint { font-family: Arial, sans-serif; font-size: 13px; opacity: 0.8; margin-top: 10px; }
#lb-info { position: absolute; left: 50%; top: 110px; transform: translateX(-50%); width: 560px; background: rgba(14,24,56,0.92); padding: 20px; font-size: 26px; text-align: center; border-top: 3px solid #4a6ad8; }
#lb-info small { display: block; font-family: Arial, sans-serif; font-size: 14px; margin-top: 8px; opacity: 0.9; line-height: 1.6; }

/* ===== css/settings.css ===== */
#settings { position: fixed; inset: 0; z-index: 40; display: none; align-items: center; justify-content: center; background: rgba(4, 12, 34, 0.72); font-family: 'Burbank Big Condensed', Impact, 'Anton', 'Arial Narrow', sans-serif; color: #fff; pointer-events: auto; }
.st-panel { width: 760px; max-height: 86vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #16244f, #0f1a3c); border: 2px solid #4a6ad8; box-shadow: 0 20px 60px rgba(0,0,0,0.6); }
.st-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; font-size: 32px; letter-spacing: 2px; background: #1e2f6e; }
.st-close { cursor: pointer; font-size: 22px; opacity: 0.85; padding: 0 6px; }
.st-close:hover { opacity: 1; color: #ffe93d; }
.st-tabs { display: flex; gap: 6px; padding: 10px 20px 0; }
.st-tabs span { padding: 6px 18px; font-size: 20px; background: rgba(30,45,90,0.85); cursor: pointer; transform: skew(-8deg); color: #dfe6ff; }
.st-tabs span.sel { background: #ffe93d; color: #101a3a; }
.st-body { overflow-y: auto; padding: 12px 20px; flex: 1; }
.st-hint { font-family: Arial, sans-serif; font-size: 13px; opacity: 0.8; margin: 4px 0 10px; line-height: 1.4; }
.st-group { font-size: 20px; letter-spacing: 1px; color: #ffe93d; margin: 12px 0 4px; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 2px; }
.st-row { display: flex; align-items: center; gap: 12px; padding: 5px 0; font-family: Arial, sans-serif; font-size: 15px; }
.st-row.bind:nth-child(even) { background: rgba(255,255,255,0.04); }
.st-label { flex: 1; }
.st-bind { min-width: 150px; text-align: center; padding: 5px 12px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.35); cursor: pointer; font-family: 'Burbank Big Condensed', Impact, 'Arial Narrow', sans-serif; font-size: 18px; letter-spacing: 1px; user-select: none; }
.st-bind:hover { border-color: #fff; background: rgba(255,255,255,0.1); }
.st-bind.listening { background: #ffe93d; color: #101a3a; border-color: #ffe93d; animation: stblink 0.8s infinite; }
.st-bind.dup { color: #ffb347; border-color: #ffb347; }
.st-bind.none { color: #ff6b6b; }
.st-clear { cursor: pointer; opacity: 0.5; font-size: 13px; width: 18px; text-align: center; }
.st-clear:hover { opacity: 1; color: #ff6b6b; }
@keyframes stblink { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(0.75); } }
.st-row input[type=range] { width: 260px; accent-color: #ffe93d; }
.st-val { width: 50px; text-align: right; font-family: 'Burbank Big Condensed', Impact, sans-serif; font-size: 18px; }
.st-toggle { position: relative; width: 52px; height: 26px; display: inline-block; }
.st-toggle input { opacity: 0; width: 0; height: 0; }
.st-toggle span { position: absolute; inset: 0; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.4); border-radius: 13px; cursor: pointer; transition: background 0.15s; }
.st-toggle span::before { content: ''; position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform 0.15s; }
.st-toggle input:checked + span { background: #3fb83a; }
.st-toggle input:checked + span::before { transform: translateX(26px); }
.st-foot { display: flex; justify-content: space-between; padding: 12px 20px; background: rgba(0,0,0,0.25); }
.st-btn { padding: 8px 22px; font-size: 20px; letter-spacing: 1px; border: 2px solid rgba(255,255,255,0.7); cursor: pointer; transform: skew(-8deg); }
.st-btn:hover { background: rgba(255,255,255,0.12); }
.st-btn.primary { background: #ffe93d; color: #101a3a; border-color: #ffe93d; }
.st-btn.primary:hover { filter: brightness(1.08); }

</style>
