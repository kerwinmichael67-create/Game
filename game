<script>
(function(){
  var LT = String.fromCharCode(60);
  function unpack(s){
    return s.split(LT+'\\/script').join(LT+'/script')
            .split(LT+'\\script').join(LT+'script')
            .split(LT+'\\!--').join(LT+'!--');
  }

  var GAMES = [
    { id:'fortnite', art:'fortnite', title:'Fortnite OG', kind:'battle royale',
      a1:'#4fa8ff', a2:'#ffe93d',
      text:'A Season 1 style island drop. Ride the bus, land, loot, build, and stay ahead of the storm. WASD to move, mouse to look and shoot.' },
    { id:'minecraft', art:'minecraft', title:'Minecraft 1.20.2', kind:'sandbox',
      a1:'#6bc24a', a2:'#cf9a4e',
      text:'An infinite blocky world to mine, place and wander. Left click breaks, right click places, and the world keeps generating as you walk.' },
    { id:'rocket', art:'rocket', title:'Rocket League', kind:'arcade soccer',
      a1:'#2e86ff', a2:'#ff8a00',
      text:'Cars playing football with boost, jumps and aerials. Keyboard, mouse or a plugged-in gamepad all work.' },
    { id:'longshot', art:'longshot', title:'Longshot: Archer Run', kind:'archery',
      a1:'#3fa372', a2:'#e8b33c',
      text:'Grow an archer squad, gather range as you run, then hold to draw and release for the final shot. Plays fine with a mouse or on a phone.' }
  ];

  var shelf = document.getElementById('shelf');
  var arts  = document.getElementById('art').querySelectorAll('svg');
  var bT    = document.getElementById('b-title');
  var bX    = document.getElementById('b-text');
  var home  = document.getElementById('home');
  var stage = document.getElementById('stage');
  var frame = document.getElementById('frame');
  var hint  = document.getElementById('hint');
  var sel   = 0, hintTimer = null;

  GAMES.forEach(function(g, i){
    var b = document.createElement('button');
    b.className = 'row';
    b.type = 'button';
    b.innerHTML = '<h2></h2><span class="kind"></span>';
    b.querySelector('h2').textContent = g.title;
    b.querySelector('.kind').textContent = g.kind;
    b.addEventListener('mouseenter', function(){ select(i); });
    b.addEventListener('focus', function(){ select(i); });
    b.addEventListener('click', function(){ select(i); launch(i); });
    shelf.appendChild(b);
  });
  var rows = shelf.querySelectorAll('.row');

  function select(i){
    sel = i;
    var g = GAMES[i];
    document.documentElement.style.setProperty('--a1', g.a1);
    document.documentElement.style.setProperty('--a2', g.a2);
    for (var k = 0; k < rows.length; k++) rows[k].classList.toggle('on', k === i);
    for (var j = 0; j < arts.length; j++) arts[j].classList.toggle('on', arts[j].getAttribute('data-art') === g.art);
    bT.textContent = g.title;
    bX.textContent = g.text;
  }

  function launch(i){
    var g = GAMES[i];
    var src = document.getElementById('src-' + g.id);
    if (!src) return;
    document.title = g.title;
    home.hidden = true;
    stage.hidden = false;
    frame.srcdoc = unpack(src.textContent).trim();
    hint.classList.remove('gone');
    clearTimeout(hintTimer);
    hintTimer = setTimeout(function(){ hint.classList.add('gone'); }, 7000);
  }

  function quit(){
    frame.removeAttribute('srcdoc');
    frame.src = 'about:blank';
    stage.hidden = true;
    home.hidden = false;
    document.title = 'Shelf \u2014 four games';
    if (document.exitPointerLock) { try { document.exitPointerLock(); } catch(e){} }
    if (rows[sel]) rows[sel].focus();
  }

  document.getElementById('exit').addEventListener('click', quit);
  document.getElementById('play').addEventListener('click', function(){ launch(sel); });

  document.addEventListener('keydown', function(e){
    if (!stage.hidden) {
      if (e.key === 'Escape' && e.shiftKey) quit();
      return;
    }
    if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); rows[(sel + 1) % rows.length].focus(); }
    else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); rows[(sel - 1 + rows.length) % rows.length].focus(); }
    else if (e.key === 'Enter' && document.activeElement === document.body) { launch(sel); }
  });

  select(0);
})();
</script>
