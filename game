/* ---------- compass ---------- */
#compass { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 480px; height: 40px; }

/* ---------- team list ---------- */
#team { position: absolute; left: 18px; top: 30px; }
.tm { margin-bottom: 8px; width: 200px; }
.tmc { display: inline-block; width: 10px; height: 10px; transform: rotate(45deg); margin-right: 8px; background: #4fc3ff; }
