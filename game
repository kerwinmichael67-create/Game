<title>Fortnite OG — Battle Royale (Season 1 recreation)</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
/* ===== css/style.css ===== */
html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #000; font-family: 'Burbank Big Condensed', Impact, 'Anton', 'Arial Narrow', 'Arial Black', sans-serif; }
#game { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; display: block; }
#loading { position: fixed; inset: 0; background: linear-gradient(180deg, #1e3a8a 0%, #3b82f6 60%, #93c5fd 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 50; color: #fff; }
.load-logo { font-size: 92px; letter-spacing: 2px; font-style: italic; text-shadow: 0 6px 0 #1b2a5a, 0 0 30px rgba(255,255,255,0.4); transform: skew(-6deg); }
.load-sub { font-size: 30px; letter-spacing: 6px; margin-top: -10px; opacity: 0.9; }
.load-bar { width: 420px; height: 16px; background: rgba(0,0,0,0.35); border: 2px solid rgba(255,255,255,0.7); margin-top: 30px; transform: skew(-12deg); overflow: hidden; }
#load-fill { height: 100%; width: 0%; background: #ffe93d; transition: width 0.2s; }
#load-text { margin-top: 12px; font-size: 22px; letter-spacing: 1px; opacity: 0.9; }
#ui { position: fixed; inset: 0; pointer-events: none; }
#debug { position: fixed; left: 8px; top: 8px; color: #fff; font: 13px monospace; background: rgba(0,0,0,0.4); padding: 4px 6px; z-index: 40; white-space: pre; pointer-events: none; }
#launch { position: fixed; inset: 0; background: linear-gradient(180deg, #0f2a6a 0%, #2563eb 55%, #7dd3fc 100%); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 60; color: #fff; cursor: pointer; }
.launch-btn { margin-top: 40px; font-size: 40px; letter-spacing: 3px; padding: 14px 46px; background: #ffe93d; color: #1b2a5a; transform: skew(-12deg); box-shadow: 0 8px 0 #b89a00; }
.launch-note { margin-top: 18px; font-size: 18px; opacity: 0.85; letter-spacing: 1px; font-family: Arial, sans-serif; }

/* ===== css/hud.css ===== */
/* ---------- shared ---------- */
#hud { position: fixed; inset: 0; pointer-events: none; font-family: 'Burbank Big Condensed', Impact, 'Anton', 'Arial Narrow', sans-serif; color: #fff; --gap: 6px; }
#hud .key { display: inline-block; min-width: 22px; padding: 1px 6px; border: 2px solid rgba(255,255,255,0.85); border-radius: 4px; font-size: 15px; text-align: center; background: rgba(0,0,0,0.35); margin-right: 6px; font-family: Arial, sans-serif; font-weight: bold; }
